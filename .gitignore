# --- Secrets: never commit keys or credentials (ANA-PLAN §0.7, §24.6) ---
.env
.env.*
# ...but the template carries no secrets and has to be committed, or nobody
# knows which variables exist.
!.env.example
*.pem
*.p8
*.p12
*.key
*service-account*.json
*credentials*.json
secrets/

# --- Gold-set fixtures: real book-page images stay local (ANA-PLAN §26, §30) ---
evals/fixtures/*
!evals/fixtures/.gitkeep
!evals/fixtures/README.md
evals/reports/

# --- Past-exam bank: the owner's PDFs never enter the repo, and neither does
# what is built from them (docs/ADR-012). Sources are read from EXAM_SOURCE_DIR.
tools/exam_bank/out/
tools/exam_bank/.venv/

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# --- Node / backend ---
node_modules/
.vercel/
dist/

# --- Xcode / iOS ---
DerivedData/
*.xcuserstate
xcuserdata/
*.ipa
*.dSYM.zip
.build/
# `xcodebuild` run from ios/ without -derivedDataPath drops its products here,
# next to the sources rather than in DerivedData/.
ios/build/
ios/CizgiCore/build/

# --- OS ---
.DS_Store
Thumbs.db

# --- Xcode project is generated from ios/project.yml via XcodeGen ---
ios/*.xcodeproj
ios/*.xcworkspace
