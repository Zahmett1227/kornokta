# Çizgi backend ortam değişkenleri (ANA-PLAN §0.6, §0.7)
#
# Kopyala:  cp .env.example .env
# `.env` gitignore'da; bu şablon değil.
#
# BURAYA ANAHTAR YAZMA. Aşağıdaki değerlerin hiçbiri gizli değil — proje adı,
# işlemci kimliği, bölge. Gerçek kimlik bilgisi tek bir yerden geliyor:
# GOOGLE_APPLICATION_CREDENTIALS'ın gösterdiği dosya. O dosya depo dışında
# durur ve içeriği asla buraya, koda veya bir log satırına girmez (§7.3).

# --- Google Document AI (birincil OCR, docs/ADR-002-birincil-ocr-secimi.md) ---

# Google Cloud proje kimliği (proje *adı* değil, altındaki id)
GOOGLE_PROJECT_ID=kornokta

# İşlemcinin oluşturulduğu bölge: eu | us
# Bir eu işlemcisi yalnızca eu- sunucusundan erişilebilir.
DOCUMENTAI_LOCATION=eu

# Document AI konsolundaki işlemci kimliği
DOCUMENTAI_PROCESSOR_ID=6213367b4c106c7e

# Tanıma dili ipuçları, virgülle. Türkçe önce: kaynak metin Türkçe ve
# Apple Vision bunu hiç yapamıyor (docs/FAZ0-BULGULAR.md).
DOCUMENTAI_LANGUAGE_HINTS=tr,en

# İstek başına zaman aşımı (ms)
DOCUMENTAI_TIMEOUT_MS=60000

# --- Kimlik bilgisi ---
# İndirdiğin servis hesabı JSON dosyasının TAM YOLU. Dosyanın kendisini
# depoya koyma; depo dışında bir yerde dursun.
# Örnek:
# GOOGLE_APPLICATION_CREDENTIALS=/Users/tugbacaglar/gizli/cizgi-backend.json
GOOGLE_APPLICATION_CREDENTIALS=

# --- Maliyet (ANA-PLAN §10.2, §11) ---

# Referans fiyat: 1.000 sayfa ≈ 1,50 USD (1 Ağustos 2026). Değişebilir.
DOCUMENTAI_USD_PER_1000_PAGES=1.5

# Bir çalıştırmanın tahmini maliyeti bunu aşarsa başlamadan durur.
# 0 = sınır yok. Denemeler sırasında küçük bir değer koymak iyi fikir.
MAX_USD_PER_RUN=0
