# Çizgi backend ortam değişkenleri (ANA-PLAN §0.6, §0.7)
#
# Kopyala:  cp .env.example .env
# `.env` gitignore'da; bu şablon değil.
#
# BURAYA ANAHTAR YAZMA. Gerçek kimlik bilgileri yalnız gerçek `.env`'de
# (gitignore'lu) veya Vercel'in ortam değişkenlerinde durur; asla buraya,
# koda veya bir log satırına girmez (§7.3).
#
# Google Document AI blokları deterministik OCR hattıyla birlikte kaldırıldı
# (ADR-005 tıraşı, 2026-08-09). Vercel'de duran eski GOOGLE_* / DOCUMENTAI_*
# değişkenleri zararsızdır, kod artık okumaz. GEMINI_* ise 2026-08-11'de çok
# daha küçük bir rolle geri döndü: aşağıdaki "Gemini ikinci görüş" bloğu.

# --- Cihaz tokenı (ANA-PLAN §7.3) ---
# Telefonun backend'e "bu benim" demesini sağlayan uzun rastgele değer.
# Üretmek için:  npm run token
# Aynı değer iki yere gider: buraya ve iPhone'un Keychain'ine. Üçüncü bir
# kopya bırakma; depoya ekleme.
DEVICE_TOKEN=

# --- OpenAI kart üretimi (ANA-PLAN §11, §14, §25 Faz 3) ---
# Anahtar hiçbir zaman koda veya bu dosyaya girmez (§0.7). Yalnız burada,
# gerçek `.env`'de (gitignore'lu) veya Vercel'in ortam değişkenlerinde durur.
OPENAI_API_KEY=

# Model kimliği kodda gömülmez (§0.6, §11.3); ANA-PLAN'ın yazıldığı tarihte
# (1 Ağustos 2026) henüz kesinleşmemiş bir isim — gerçek sürüm netleşince
# burası güncellenir.
OPENAI_MODEL=gpt-5.6-sol
# Faz 6/B3: vision çağrısının baskın gecikme maliyeti reasoning token'ları.
# "high"/"medium" yoğun işaretli bir sayfada çağrıyı zaman aşımına sokuyordu →
# "low". Bir async iş (B4) arkasında bütçeye rahat sığarsa yükseltilebilir.
OPENAI_REASONING_EFFORT=low

# Faz 6/B3: `input_image` detay seviyesi ("low" | "high" | "auto"). "high",
# modelin tüm sayfayı çözünürlükte karolayıp soluk kenar el yazısını ve ince
# fosforlu çizgileri gerçekten okumasını sağlar (docs/FAZ6-PLAN.md §5.2). Ek
# girdi tokeni getirir, gecikmeye reasoning kadar etki etmez.
OPENAI_IMAGE_DETAIL=high

# §20.3'ün referans sayısı (700) yalnız görünür kart içeriğini varsayıyordu.
# Gerçek modelin kendi (görünmeyen) reasoning token'ları da bu bütçeden
# düşülüyor: 700'de gerçek bir çağrı status:"incomplete" ile durdu (2026-08-02).
# Faz 6/B3: yoğun işaretli bir tam sayfa 12 karta kadar üretebildiği için
# 4096→8192 yükseltildi (aksi halde çıktı `status:"incomplete"` ile kırpılıyor).
# Sayfa başına kart tavanı 12'den 18'e çıkınca aynı oranda 8192→12288 (2026-08-14).
OPENAI_MAX_OUTPUT_TOKENS=12288

# Sayfa başına kart üst sınırı (§11.3, §13.2, §24.4). Faz 6/B3: eski
# "tek pasaj → ≤4 kart" akışının 4'ü, vision akışında modelin bütçesini ilk
# birkaç temel basılı olguya harcayıp el yazısı notlarını atlamasına yol
# açıyordu (2. cihaz testi) → 12, sonra 18 (2026-08-14, sahibinin isteği).
OPENAI_MAX_CARDS_PER_KNOWLEDGE_UNIT=18

# Beş şıklı (TUS tipi) kart üretimi (§13.3). off | mixed | all
#   off   — hiç üretme (şema v2.1 öncesi davranış).
#   mixed — yalnız beş şıkla gerçekten sınanan kartlar (ayırt etme, istisna/tuzak).
#   all   — üretilebilen her kart beş şıklı; daha çok çıktı token'ı, daha yavaş.
# Her şık takımı ~80–150 ek çıktı token'ı demek ve gecikmenin baskın bileşeni
# çıktı token'ı — "all"ı ölçmeden açma. İstemci (Ayarlar) bunu AŞAĞI çekebilir,
# yukarı değil (§21.3).
OPENAI_MULTIPLE_CHOICE_MODE=mixed

# Faz 6/B3: tam sayfa vision okuması + 12 karta kadar üretim bir dakikayı aşabilir.
# 60000 (=60 s) tüm zaman aşımı sorununun köküydü (tekrarlayan
# `providerUnavailable`). vercel.json maxDuration 300'e çıkarıldı; bu değer onun
# hemen altında iptal edip temiz, yeniden-denenebilir bir hata döndürsün diye 290000.
# ⚠️ DAĞITIM: Bu bir KOD VARSAYILANI DEĞİL, ortam değeridir. Mevcut bir .env'de
# veya VERCEL'İN ORTAM DEĞİŞKENLERİNDE bu satır hâlâ 60000 duruyorsa, config.ts'in
# yeni 290000 varsayılanı hiç devreye girmez ve çağrı yine 60 s'de kesilir. Elle
# güncelle (Vercel değişikliği YENİ BİR DAĞITIM ister).
OPENAI_TIMEOUT_MS=290000

# 1 milyon token başına USD. Varsayılan 0: bu spesifikasyonun yazıldığı tarihte
# doğrulanmış bir fiyat yok, uydurma bir rakam koymaktansa maliyeti dürüstçe
# sıfır göstermek tercih edildi. Sağlayıcının kendi fiyat sayfasından doldur.
OPENAI_USD_PER_MILLION_INPUT_TOKENS=0
OPENAI_USD_PER_MILLION_OUTPUT_TOKENS=0

# Sağlayıcının önbelleğinden gelen girdi tokenı ayrı (ve çok daha ucuz)
# fiyatlanır — güncel modellerde girdi fiyatının onda biri civarı. Sağlayıcı
# önbellekten gelen payı `usage` içinde bildiriyor; bu değer girilmezse
# **girdi fiyatına eşit** kabul edilir, 0'a DEĞİL. Sebebi: 0 varsayımı
# önbellekli tokenları defterde bedava gösterir ve Kullanım toplamı gerçek
# faturanın altında kalır — bu muhasebenin kapatmak için var olduğu hata tam
# olarak budur. Fazla göstermek, eksik göstermekten güvenli yön.
OPENAI_USD_PER_MILLION_CACHED_INPUT_TOKENS=

# Bir kart üretimi çağrısının tahmini üst sınır maliyeti bunu aşarsa (fiyat
# alanları doldurulduysa) çağrı hiç yapılmadan durur. 0 = sınır yok.
MAX_USD_PER_CARD_GENERATION=0

# --- Gemini ikinci görüş (/api/second-opinion, §10.4'ün Faz 6 hali) ---
#
# Bu blok İSTEĞE BAĞLI ve yalnız /api/second-opinion'ı besler: "Gözden geçir"
# ekranındaki lowConfidence bir kart için, kartı üreten OpenAI'den BAĞIMSIZ
# bir modele sayfayı yeniden okutup "sayfa kartı destekliyor mu?" cevabı alır.
# GEMINI_API_KEY boşsa yalnız bu uç "eksik ortam değişkeni" der; kart üretimi
# hiç etkilenmez.
#
# Anahtar: aistudio.google.com → Get API key (docs/OPENAI-GEMINI-KURULUM.md).
# Kota/kredi biterse endpoint bunu MASKELEMEZ: hata mesajı açıkça "kota/kredi
# tükendi, aistudio.google.com'dan kontrol et" der (sahibinin şartı) — sorun
# aramakla vakit kaybetme.
GEMINI_API_KEY=

# Model kimliği koda gömülmez (§0.6). Flash katmanı bilinçli: tek bölgenin
# transkripsiyon + karşılaştırması, kart üretimi değil.
GEMINI_MODEL=gemini-3.5-flash

# Görünür cevap kısa (verdict + okuma) ama düşünen modellerde gizli düşünme
# token'ları da bu bütçeden düşülüyor — OPENAI_MAX_OUTPUT_TOKENS'taki
# status:"incomplete" dersinin aynısı. Kısa çıktıda cömert tavan ucuzdur.
GEMINI_MAX_OUTPUT_TOKENS=4096

# Tek bölge okuması; kullanıcı telefonda bekliyor. Bir dakikayı aşan cevabın
# adı "tekrar dene"dir.
GEMINI_TIMEOUT_MS=60000

# 1 milyon token başına USD; OpenAI çiftiyle aynı kural — doğrulanmış fiyat
# girilene kadar 0 (uydurma rakam maliyet logunda otoriter görünür).
GEMINI_USD_PER_MILLION_INPUT_TOKENS=0
GEMINI_USD_PER_MILLION_OUTPUT_TOKENS=0

# OpenAI'deki önbellek fiyatıyla aynı kural: girilmezse girdi fiyatına eşit
# sayılır, 0'a değil.
GEMINI_USD_PER_MILLION_CACHED_INPUT_TOKENS=

# --- Karanlık Harita / /api/dark-map (docs/ADR-009) ---
#
# Bu blok İSTEĞE BAĞLI: hiçbirini girmezsen uç, aşağıdaki varsayılanlarla
# çalışır. GEMINI_API_KEY yoksa uç yine çalışır ama **tek sıralayıcıyla** —
# yanıtta singleRater: true döner ve her bölge "tartışmalı" etiketlenir.
# Mutabakat kapısının kendisi kaybolur; ekran bunu açıkça söyler.
#
# Kendi bütçe bloğu var, OpenAI'ninkini ödünç almıyor: kart üretimi tam
# çözünürlüklü bir sayfa görüntüsü gönderip 18 karta kadar yazıyor, bu çağrı
# ~143 satır metin gönderip en fazla bir düzine kısa yargı yazıyor. Ortak
# değişken kullansaydı yakalama hattının her ayarı sessizce burayı da
# ayarlardı.

# Kaç konu döndürülebilir. Bu bir çalışma sırası, envanter değil: tabloyu
# olduğu gibi geri veren bir sıralama için iki model çağrısı ödemeye değmez.
DARK_MAP_MAX_ZONES=12

# Konu başına modele iletilen kart sorusu sayısı. Sayının yalan söylediği
# durumu (on iki kartın on ikisi de aynı tanım) yalnız bu görebiliyor.
# 0 = örnekleme kapalı, saf sayı tablosu.
DARK_MAP_MAX_SAMPLE_FRONTS=4

# ⚠️ Bu ikisi ÇİFTTİR (CLAUDE.md'deki kural): effort yükseltilip tavan
# yükseltilmezse her çağrı TAM ÜCRETLE düşer. Tur A2'nin ilk denemesi 6/6
# böyle kaybetti. Reasoning token'ları çıktı bütçesinden iner.
DARK_MAP_REASONING_EFFORT=medium
DARK_MAP_MAX_OUTPUT_TOKENS=16384

# İki metin çağrısı, kullanıcı ekranda bekliyor. Sayfa üretiminin dakikalarına
# benzemez.
DARK_MAP_TIMEOUT_MS=120000

# --- Asenkron iş kuyruğu / Supabase (docs/ADR-006) ---
#
# Bu blok İSTEĞE BAĞLI. SUPABASE_URL boşsa /api/cards-vision eskisi gibi
# çalışır, yalnız /api/jobs "eksik ortam değişkeni" der.
#
# Neden var: telefonun, modelin sürdüğü 1–5 dakika boyunca tek bir HTTP
# bağlantısını açık tutması gerekiyordu ve hiçbir telefon bunu güvenilir
# biçimde yapamıyor (ekran kilitleniyor → iOS uygulamayı askıya alıyor →
# yükleme zaman aşımıyla ölüyor). /api/jobs ile bekleme telefondan çıkıyor.

# Proje URL'i. Gizli değil — yetkiyi aşağıdaki servis anahtarı veriyor.
SUPABASE_URL=https://lnfzihogoxixlukygicz.supabase.co

# Sayfa baytlarının işin süresince durduğu özel (private) kova.
# Migration bu adla oluşturuyor; değiştirirsen kovayı da değiştir.
SUPABASE_BUCKET=page-uploads

# Supabase çağrısı başına zaman aşımı (ms)
SUPABASE_TIMEOUT_MS=30000

# Bundan uzun süredir "processing" olan bir iş, işleyen sunucusu kendi süre
# tavanında öldürülmüş sayılır ve tekrar denenebilir hata olarak geri alınır.
# vercel.json'daki 300 s tavanın ÜSTÜNDE olmalı; altında olursa yalnızca
# yavaş olan bir iş, hâlâ cevap verecekken elinden alınır.
SUPABASE_JOB_STALE_AFTER_MS=330000

# Biten (ready/failed) iş satırlarının — üretilen kart metinleri + modelin
# okuduğu sayfa metni — silinmeden önce en fazla ne kadar duracağı (ms).
# Varsayılan 60 gün (sahibinin kararı, docs/PRIVACY.md). Süpürme cron değil,
# telefonun yoklamalarına biner. Bu süreden uzun kapalı kalan bir telefon,
# sonucu alınmamış sayfayı yeniden gönderir ve ikinci üretim ücreti öder —
# bilinçli kabul edilen ödünç.
SUPABASE_RESULT_RETENTION_MS=5184000000

# Servis rolü anahtarı. RLS'i tamamen atlar; bu depodaki en güçlü sırdır.
# BURAYA YAZMA — yalnız yerel `.env` dosyana ve Vercel proje ayarlarına.
# Supabase panelinde: Project Settings → API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=
