# Çizgi backend ortam değişkenleri (ANA-PLAN §0.6, §0.7)
#
# Kopyala:  cp .env.example .env
# `.env` gitignore'da; bu şablon değil.
#
# BURAYA ANAHTAR YAZMA. Aşağıdaki değerlerin hiçbiri gizli değil — proje adı,
# işlemci kimliği, bölge. Gerçek kimlik bilgisi tek bir yerden geliyor:
# GOOGLE_APPLICATION_CREDENTIALS'ın gösterdiği dosya. O dosya depo dışında
# durur ve içeriği asla buraya, koda veya bir log satırına girmez (§7.3).

# --- Google Document AI (birincil OCR, docs/ADR-002-birincil-ocr-secimi.md) ---

# Google Cloud proje kimliği (proje *adı* değil, altındaki id)
GOOGLE_PROJECT_ID=kornokta

# İşlemcinin oluşturulduğu bölge: eu | us
# Bir eu işlemcisi yalnızca eu- sunucusundan erişilebilir.
DOCUMENTAI_LOCATION=eu

# Document AI konsolundaki işlemci kimliği
DOCUMENTAI_PROCESSOR_ID=6213367b4c106c7e

# Tanıma dili ipuçları, virgülle. Türkçe önce: kaynak metin Türkçe ve
# Apple Vision bunu hiç yapamıyor (docs/FAZ0-BULGULAR.md).
DOCUMENTAI_LANGUAGE_HINTS=tr,en

# İstek başına zaman aşımı (ms)
DOCUMENTAI_TIMEOUT_MS=60000

# --- Cihaz tokenı (ANA-PLAN §7.3) ---
# Telefonun backend'e "bu benim" demesini sağlayan uzun rastgele değer.
# Üretmek için:  npm run token
# Aynı değer iki yere gider: buraya ve iPhone'un Keychain'ine. Üçüncü bir
# kopya bırakma; depoya ekleme.
DEVICE_TOKEN=

# --- Kimlik bilgisi ---
# Yerelde çalıştırırken (npm run serve/ocr): indirdiğin servis hesabı JSON
# dosyasının TAM YOLU. Dosyanın kendisini depoya koyma; depo dışında bir
# yerde dursun.
# Örnek:
# GOOGLE_APPLICATION_CREDENTIALS=/Users/tugbacaglar/gizli/cizgi-backend.json
GOOGLE_APPLICATION_CREDENTIALS=

# Vercel'e dağıtırken: yukarıdaki dosya yolu orada geçersiz — dağıtılan
# sunucuda böyle bir dosya yok. Onun yerine dosyanın TÜM İÇERİĞİNİ tek
# satır JSON olarak bu değişkene koy (yalnız Vercel proje ayarlarında;
# buraya, .env'e YAZMA). Ayrıntı: README.md "Vercel'e dağıtım".
# GOOGLE_CREDENTIALS_JSON=

# --- Maliyet (ANA-PLAN §10.2, §11) ---

# Referans fiyat: 1.000 sayfa ≈ 1,50 USD (1 Ağustos 2026). Değişebilir.
DOCUMENTAI_USD_PER_1000_PAGES=1.5

# Bir çalıştırmanın tahmini maliyeti bunu aşarsa başlamadan durur.
# 0 = sınır yok. Denemeler sırasında küçük bir değer koymak iyi fikir.
MAX_USD_PER_RUN=0

# --- OpenAI kart üretimi (ANA-PLAN §11, §14, §25 Faz 3) ---
# Anahtar hiçbir zaman koda veya bu dosyaya girmez (§0.7). Yalnız burada,
# gerçek `.env`'de (gitignore'lu) veya Vercel'in ortam değişkenlerinde durur.
OPENAI_API_KEY=

# Model kimliği kodda gömülmez (§0.6, §11.3); ANA-PLAN'ın yazıldığı tarihte
# (1 Ağustos 2026) henüz kesinleşmemiş bir isim — gerçek sürüm netleşince
# burası güncellenir.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=700

# Pasaj başına kart üst sınırı (§11.3, §13.2, §24.4).
OPENAI_MAX_CARDS_PER_KNOWLEDGE_UNIT=4
OPENAI_TIMEOUT_MS=60000

# 1 milyon token başına USD. Varsayılan 0: bu spesifikasyonun yazıldığı tarihte
# doğrulanmış bir fiyat yok, uydurma bir rakam koymaktansa maliyeti dürüstçe
# sıfır göstermek tercih edildi. Sağlayıcının kendi fiyat sayfasından doldur.
OPENAI_USD_PER_MILLION_INPUT_TOKENS=0
OPENAI_USD_PER_MILLION_OUTPUT_TOKENS=0

# --- Gemini el yazısı ikinci görüşü (ANA-PLAN §10.4, §11.1) ---
# Yalnız belirsiz/el yazılı bölgeler için çağrılır; kart üretimi bu sağlayıcıyı
# hiç kullanmaz.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# 700 gerçek bir çağrıda MAX_TOKENS'a çarptı: görünür yanıt (metin + birkaç
# belirsiz span) küçük olsa da model bir kısmını kendi iç muhakemesine
# harcıyor. Zaten mevcut bir .env'de bu satır 700 olarak duruyorsa elle
# yükseltmen gerekir — kod varsayılanı değişmesi orada işe yaramaz.
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TIMEOUT_MS=60000
GEMINI_USD_PER_MILLION_INPUT_TOKENS=0
GEMINI_USD_PER_MILLION_OUTPUT_TOKENS=0

# Bir kart üretimi çağrısının tahmini üst sınır maliyeti bunu aşarsa (fiyat
# alanları doldurulduysa) çağrı hiç yapılmadan durur. 0 = sınır yok.
MAX_USD_PER_CARD_GENERATION=0
