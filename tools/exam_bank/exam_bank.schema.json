{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cizgi.local/exam_bank.schema.json",
  "title": "Çıkmış soru bankası (bank.json), sürüm 1",
  "description": "docs/PLAN-cikmis-soru-bankasi.md §6. Tek kaynak: Faz A2'deki Swift ExamBankDocument bu şemayla kilitlenir. Soru kimliği bir kez verildikten sonra asla başka soruya verilmez.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bankVersion", "subjectSchemaVersion", "builtAt", "papers", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bankVersion": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$" },
    "subjectSchemaVersion": { "type": "integer", "minimum": 1 },
    "builtAt": { "type": "string", "format": "date-time" },
    "papers": { "type": "array", "items": { "$ref": "#/$defs/paper" } },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }
  },
  "$defs": {
    "paperId": { "type": "string", "pattern": "^TUS-20\\d\\d-[12]-(T|K|T2)$" },
    "pdfPath": { "type": "string", "pattern": "^pdf/[0-9a-f]{64}\\.pdf$" },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdf", "page", "bbox"],
      "properties": {
        "pdf": { "$ref": "#/$defs/pdfPath" },
        "page": { "type": "integer", "minimum": 1, "description": "1 tabanlı, paketteki PDF'in sayfası" },
        "bbox": {
          "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" },
          "description": "[x0, top, x1, bottom], punto, sol üst köken (pdfplumber). PDFKit: y = sayfaYüksekliği − bottom"
        }
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "year", "session", "test", "date", "questionCount", "timeLimitMinutes",
                   "sessionTimeLimitMinutes", "penalty", "sourceKind", "keySource", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/paperId" },
        "year": { "type": "integer", "minimum": 2006, "maximum": 2099 },
        "session": { "enum": [1, 2] },
        "test": { "enum": ["T", "K", "T2"] },
        "date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "questionCount": { "type": "integer", "minimum": 1 },
        "timeLimitMinutes": { "type": ["integer", "null"], "minimum": 1 },
        "sessionTimeLimitMinutes": { "type": ["integer", "null"], "minimum": 1 },
        "penalty": { "enum": ["quarter", "unknown"] },
        "sourceKind": { "enum": ["osym", "osymPartial", "tusdata", "reconstruction"] },
        "keySource": { "enum": ["osym", "tusdata", "reconstruction", "none"] },
        "sources": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pdf", "family", "sourceKind", "keySource"],
            "properties": {
              "pdf": { "$ref": "#/$defs/pdfPath" },
              "family": { "enum": ["F1", "F2", "F3", "F4", "F5", "F6"] },
              "sourceKind": { "enum": ["osym", "osymPartial", "tusdata", "reconstruction"] },
              "keySource": { "enum": ["osym", "tusdata", "reconstruction", "none"] }
            }
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paperId", "number", "stem", "options", "answer", "answerSource", "status",
                   "osymSubject", "subject", "topic", "figure", "provenance", "altProvenance",
                   "textQuality", "textSource", "printedAs", "similarTo"],
      "properties": {
        "id": { "type": "string", "pattern": "^TUS-20\\d\\d-[12]-(T|K|T2)-\\d{3}$" },
        "paperId": { "$ref": "#/$defs/paperId" },
        "number": { "type": "integer", "minimum": 1, "maximum": 200 },
        "stem": { "type": "string" },
        "options": {
          "type": "array", "items": { "type": "string" },
          "anyOf": [{ "minItems": 5, "maxItems": 5 }, { "maxItems": 0 }],
          "description": "A–E sırasıyla beş şık; kitapçığın metnini 'Bu soru iptal edilmiştir.' ile değiştirdiği iptal sorularda boş"
        },
        "answer": { "type": ["integer", "null"], "minimum": 0, "maximum": 4 },
        "answerSource": { "enum": ["osym", "tusdata", "reconstruction", null] },
        "status": { "enum": ["ok", "cancelled", "keyless", "modified", "needsHuman"] },
        "osymSubject": {
          "enum": ["Anatomi", "Histoloji-Embriyoloji", "Fizyoloji", "Biyokimya", "Mikrobiyoloji", "Patoloji",
                   "Farmakoloji", "Dahiliye", "Pediatri", "Genel Cerrahi", "Kadın Hastalıkları ve Doğum",
                   "Küçük Stajlar", null]
        },
        "subject": { "type": ["string", "null"], "description": "uygulamanın kanonik dersi (subject_topics.json)" },
        "topic": { "type": ["string", "null"] },
        "figure": { "enum": ["none", "reference", "required"] },
        "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/region" } },
        "altProvenance": { "type": "array", "items": { "$ref": "#/$defs/region" } },
        "textQuality": { "enum": ["native", "repaired", "vision"] },
        "textSource": { "enum": ["osym", "tusdata", "reconstruction"] },
        "printedAs": { "type": ["integer", "null"], "description": "kitapçık bu numarayı yanlış basmışsa basılan numara" },
        "similarTo": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
